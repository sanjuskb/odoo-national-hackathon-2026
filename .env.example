# ==============================================================================
# Odoo National Hackathon 2026 - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env BEFORE RUNNING LOCALLY:
#   cp .env.example .env
# NEVER COMMIT .env OR REAL SECRETS/PASSWORDS TO GIT!
# ==============================================================================

# Application Configuration
APP_ENV=development
APP_PORT=3000
API_BASE_URL=http://localhost:5000/api/v1

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Password Reset
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Database Configuration (Placeholder - will align with selected stack)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hackathon_db
DB_USER=hackathon_user
DB_PASSWORD=your_secure_password_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_change_in_production
SESSION_SECRET=your_session_secret_change_in_production

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug
