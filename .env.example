# ==============================================================================
# Odoo National Hackathon 2026 - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env BEFORE RUNNING LOCALLY:
#   cp .env.example .env
# NEVER COMMIT .env OR REAL SECRETS/PASSWORDS TO GIT!
# ==============================================================================

# Application Configuration
APP_ENV=development
APP_PORT=3000
API_BASE_URL=http://localhost:5000/api/v1

# Database Configuration (Supabase PostgreSQL)
# Direct / Pooler PostgreSQL connection details (for Node.js pg / backend drivers)
DB_HOST=aws-0-[REGION].pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.[YOUR-PROJECT-REF]
DB_PASSWORD=your_secure_db_password_here

# Full PostgreSQL Connection URIs
# Pooled (Session/Transaction) for serverless or backend API queries
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:your_secure_db_password_here@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for schema migrations / DDL
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:your_secure_db_password_here@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase API Configuration (Client SDK & Supabase Auth)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
# Server-only service role key - NEVER expose to frontend or commit to version control
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_change_in_production
SESSION_SECRET=your_session_secret_change_in_production

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
# Synced from shared develop: backend is on PORT 5000, API prefix /api/v1; real credentials only in ignored local .env.
