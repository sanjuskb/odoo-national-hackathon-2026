# ==============================================================================
# Odoo National Hackathon 2026 - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env BEFORE RUNNING LOCALLY:
#   cp .env.example .env
# NEVER COMMIT .env OR REAL SECRETS/PASSWORDS TO GIT!
# ==============================================================================

# Application Configuration
APP_ENV=development
APP_PORT=3000
API_BASE_URL=http://localhost:3000/api

# Database Configuration (Placeholder - will align with selected stack)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hackathon_db
DB_USER=hackathon_user
DB_PASSWORD=your_secure_password_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_change_in_production
SESSION_SECRET=your_session_secret_change_in_production

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug
