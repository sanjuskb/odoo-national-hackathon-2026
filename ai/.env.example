# ==============================================================================
# AI/ML Module - Environment Configuration Template
# Odoo National Hackathon 2026
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in local configuration values.
# 3. NEVER commit real API keys, secrets, or tokens to version control.
# ==============================================================================

# Environment & Server
AI_ENV=development
AI_PORT=8000
AI_HOST=127.0.0.1
LOG_LEVEL=INFO

# Backend Integration (Amarnath's Backend API)
BACKEND_BASE_URL=http://localhost:3000/api/v1
BACKEND_TIMEOUT_SECONDS=10.0
AI_SERVICE_ENABLED=true

# Model & Inference Settings
MODEL_NAME=provisional_heuristic_model
MODEL_VERSION=0.1.0-alpha
MODEL_STORAGE_PATH=./models
MAX_BATCH_SIZE=32
INFERENCE_TIMEOUT_SECONDS=5.0

# Optional External AI/LLM Provider (ONLY if justified by problem statement)
# DO NOT add real keys here.
AI_PROVIDER=none
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# Gemini LLM Provider (Brightloop AI Assistant)
# Server-side only; never expose in frontend
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=10.0
GEMINI_TEMPERATURE=0.2

# Murf Text-to-Speech Provider (Brightloop Voice Assistance)
# Server-side only
MURF_API_KEY=
MURF_VOICE_ID=en-US-marcus
MURF_TIMEOUT_SECONDS=10.0

# Telephony Provider & Background Call Assistance Settings
TELEPHONY_PROVIDER=mock
USE_MOCK_PROVIDERS=true
CALL_ASSISTANCE_WINDOW_SECONDS=60
CALL_MAX_RETRIES=3

